import sys
from abc import ABC, abstractmethod

class PaymentMethod(ABC):
    def __init__(self, amount: float):
        self.amount = amount

    @abstractmethod
    def calculate_final_amount(self) -> float:
        pass

    @abstractmethod
    def get_payment_type(self) -> str:
        pass

class CardPayment(PaymentMethod):
    def calculate_final_amount(self) -> float:
        return self.amount * 1.02

    def get_payment_type(self) -> str:
        return "CARD"

class WalletPayment(PaymentMethod):
    def calculate_final_amount(self) -> float:
        return self.amount * 1.01

    def get_payment_type(self) -> str:
        return "WALLET"

class BankTransferPayment(PaymentMethod):
    def calculate_final_amount(self) -> float:
        return self.amount

    def get_payment_type(self) -> str:
        return "BANKTRANSFER"

class PaymentFactory:
    _REGISTRY = {
        "CARD": CardPayment,
        "WALLET": WalletPayment,
        "BANKTRANSFER": BankTransferPayment
    }

    @classmethod
    def create_payment(cls, p_type: str, amount: float) -> PaymentMethod:
        payment_cls = cls._REGISTRY.get(p_type.upper())
        if not payment_cls:
            raise ValueError(f"Unknown payment type: {p_type}")
        return payment_cls(amount)

def main():
    input_data = sys.stdin.read().splitlines()
    if not input_data:
        return
    
    n = int(input_data[0].strip())
    transactions = []
    
    for i in range(1, n + 1):
        parts = input_data[i].strip().split()
        p_type = parts[0]
        amount = float(parts[1])
        transactions.append(PaymentFactory.create_payment(p_type, amount))

    grand_total = 0.0
    for transaction in transactions:
        final_amount = transaction.calculate_final_amount()
        grand_total += final_amount
        print(f"{transaction.get_payment_type()}: {final_amount:.2f}")

    print(f"Total: {grand_total:.2f}")

if __name__ == "__main__":
    main()
