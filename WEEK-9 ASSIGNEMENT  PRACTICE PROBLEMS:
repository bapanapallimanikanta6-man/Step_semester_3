1.MOVIE TICKET COUNTER:

import java.util.Scanner;

class MovieTicketCounter {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) return;
        int n = scanner.nextInt();
        double total = 0;
        final double CONVENIENCE_FEE = 20.0;

        for (int i = 0; i < n; i++) {
            String seatType = scanner.next();
            int count = scanner.nextInt();
            
            double basePricePerTicket = 0;
            switch (seatType) {
                case "REGULAR": basePricePerTicket = 150; break;
                case "PREMIUM": basePricePerTicket = 250; break;
                case "RECLINER": basePricePerTicket = 400; break;
            }
            
            double amount = count * (basePricePerTicket + CONVENIENCE_FEE);
            total += amount;
            System.out.printf("%s: %.2f\n", seatType, amount);
        }
        System.out.printf("Total: %.2f\n", total);
        scanner.close();
    }
}

2.PARCEL SHIPPING DESKTOP:



import java.util.Scanner;

class ParcelShippingDesk {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) return;
        int n = scanner.nextInt();
        double grandTotal = 0;

        for (int i = 0; i < n; i++) {
            String type = scanner.next();
            double weight = scanner.nextDouble();
            double declaredValue = scanner.nextDouble();

            double charge = 0;
            double insurance = 0;

            switch (type) {
                case "STANDARD":
                    charge = 40 + 10 * weight;
                    insurance = 0.0;
                    break;
                case "EXPRESS":
                    charge = 80 + 15 * weight;
                    insurance = 0.02 * declaredValue;
                    break;
                case "FRAGILE":
                    double standardCharge = 40 + 10 * weight;
                    charge = standardCharge + 50;
                    insurance = 0.02 * declaredValue;
                    break;
            }

            double total = charge + insurance;
            grandTotal += total;
            System.out.printf("%s: Charge=%.2f Insurance=%.2f Total=%.2f\n", type, charge, insurance, total);
        }
        System.out.printf("Grand Total: %.2f\n", grandTotal);
        scanner.close();
    }
}

3.COLLEGE FEE COUNTER:


import java.util.Scanner;

class CollegeFeeCounter {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) return;
        int n = scanner.nextInt();
        double totalCollected = 0;
        final double TRANSPORT_FEE = 12000.0;

        for (int i = 0; i < n; i++) {
            String type = scanner.next();
            String name = scanner.next();

            double tuition = 40000.0;
            double extraFee = 0.0;
            boolean usesBus = false;

            switch (type) {
                case "DAY_SCHOLAR":
                    tuition = 40000.0;
                    usesBus = true;
                    break;
                case "HOSTELLER":
                    tuition = 40000.0;
                    extraFee = 60000.0;
                    usesBus = false;
                    break;
                case "SCHOLAR":
                    tuition = 20000.0;
                    usesBus = true;
                    break;
            }

            double fee = tuition + extraFee;
            if (usesBus) {
                fee += TRANSPORT_FEE;
            }

            totalCollected += fee;
            System.out.printf("%s: %.2f\n", name, fee);
        }
        System.out.printf("Total Collected: %.2f\n", totalCollected);
        scanner.close();
    }
}

4.CITY CAB FARE METER:


import java.util.Scanner;

class CityCabFareMeter {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) return;
        int n = scanner.nextInt();
        double total = 0;

        for (int i = 0; i < n; i++) {
            String cab = scanner.next();
            double km = scanner.nextDouble();
            String time = scanner.next();

            if (cab.equals("MINI") && time.equals("NIGHT")) {
                System.out.println(cab + ": night service not available");
                continue;
            }

            double rate = 0;
            switch (cab) {
                case "MINI": rate = 10; break;
                case "SEDAN": rate = 14; break;
                case "SUV": rate = 18; break;
            }

            double fare = km * rate;
            if (fare < 100) {
                fare = 100;
            }

            if (time.equals("NIGHT")) {
                fare += fare * 0.20;
            }

            total += fare;
            System.out.printf("%s: %.2f\n", cab, fare);
        }
        System.out.printf("Total: %.2f\n", total);
        scanner.close();
    }
}

5.HOME APPLIANCE ENERGY  REPORT:


import java.util.Scanner;

class HomeApplianceEnergyReport {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) return;
        int n = scanner.nextInt();
        double totalCost = 0;

        for (int i = 0; i < n; i++) {
            String appliance = scanner.next();
            double hours = scanner.nextDouble();
            
            boolean hasSaver = false;
            if (scanner.hasNext("[a-zA-Z]+")) {
                String nextWord = scanner.next();
                if (nextWord.equals("SAVER")) {
                    hasSaver = true;
                }
            }

            double power = 0;
            boolean supportsSaver = false;

            switch (appliance) {
                case "FRIDGE":
                    power = 150;
                    supportsSaver = false;
                    break;
                case "AC":
                    power = 1500;
                    supportsSaver = true;
                    break;
                case "TV":
                    power = 100;
                    supportsSaver = false;
                    break;
                case "WASHER":
                    power = 500;
                    supportsSaver = true;
                    break;
            }

            if (hasSaver && !supportsSaver) {
                System.out.println(appliance + ": saver mode not supported");
                continue;
            }

            double units = (power * hours) / 1000.0;
            if (hasSaver && supportsSaver) {
                units -= units * 0.25;
            }

            double cost = units * 8.0;
            totalCost += cost;
            System.out.printf("%s: Units=%.2f Cost=%.2f\n", appliance, units, cost);
        }
        System.out.printf("Total Cost: %.2f\n", totalCost);
        scanner.close();
    }
}

